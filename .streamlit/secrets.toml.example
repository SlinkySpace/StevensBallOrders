# Copy this file to .streamlit/secrets.toml and fill in real values.
#
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# secrets.toml is gitignored and must stay that way: DATABASE_URL and
# SMTP_PASSWORD are live credentials. This .example file has no real values in
# it, so it is safe to commit.
#
# On Streamlit Community Cloud you do NOT create this file. Paste the same TOML
# into the app's Settings -> Secrets box instead; the deployed app has no
# filesystem you can put it on.
#
# Every key is optional. With none of them set the app still runs, using a local
# SQLite file and the fallback owner list in config.py.


# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Neon / Supabase connection string. Leave unset to use the local SQLite file
# (fine for development, but Streamlit Community Cloud wipes its filesystem on
# every restart, so production needs this).
#
# Neon gives you this under "Connection string" - use the pooled one. Keep
# sslmode=require.
DATABASE_URL = "postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"


# ---------------------------------------------------------------------------
# Access control
# ---------------------------------------------------------------------------
# Who sees the Owner Dashboard and Catalog Manager. Setting this here overrides
# the fallback list in config.py, which is visible in the public repo.
OWNER_EMAILS = [
    "jela@stevens.edu",
    "echin1@stevens.edu",
    "valdridg@stevens.edu",
    "abranco@stevens.edu",
    "cfolgore@stevens.edu",
    "msantos2@stevens.edu",
    "jwang12@stevens.edu",
    "mderosa@stevens.edu",
]

# Shared code required to create an account, and to set a password on an account
# that predates passwords. Share it with the team however you normally talk.
#
# Leave this unset and anyone who finds the app's URL can create an account -
# and, until each existing account sets a password, claim one. The Owner
# Dashboard shows a red banner while that is true.
TEAM_ACCESS_CODE = "pick-something-and-share-it-with-the-team"

# Minimum password length. Defaults to 8.
MIN_PASSWORD_LENGTH = 8


# ---------------------------------------------------------------------------
# Email notifications
# ---------------------------------------------------------------------------
# Customers get an email when their order moves to approved / ordered /
# fulfilled. Owners get one when enough bowling balls are waiting to place a
# batch order.
#
# Set to false to print emails to the console instead of sending them - useful
# locally so you don't mail the team while testing.
EMAIL_NOTIFICATIONS_ENABLED = true

# Gmail requires an App Password, not your normal account password. Generate one
# at https://myaccount.google.com/apppasswords (needs 2-Step Verification on).
# Treat it like a password, because it is one.
SMTP_USERNAME = "youraddress@gmail.com"
SMTP_PASSWORD = "your-16-character-app-password"

# Defaults below suit Gmail; change only for a different provider.
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = 587
SMTP_USE_TLS = true
